{
  "endpoints": {
    "usuarios_publicos": {
      "registrar": {
        "method": "POST",
        "path": "/api/users/registrar",
        "auth": false,
        "descripcion": "Registrar nuevo usuario",
        "version": "v1.0"
      },
      "login": {
        "method": "POST", 
        "path": "/api/users/login",
        "auth": false,
        "descripcion": "Iniciar sesión (retorna JWT)",
        "version": "v1.0"
      },
      "perfil_publico": {
        "method": "GET",
        "path": "/api/users/:nickname",
        "auth": false,
        "descripcion": "Ver perfil público de cualquier usuario",
        "version": "v1.0",
        "respuesta": {
          "nickname": "tech_lover",
          "avatar": "https://cloudflare-r2/avatars/lovers.webp",
          "created_at": "2024-01-15T10:30:00Z"
        }
      },
      "libros_publicos": {
        "method": "GET",
        "path": "/api/users/:nickname/libros",
        "auth": false,
        "descripcion": "Listar libros públicos de un usuario",
        "version": "v1.0"
      }
    },
    
    // ========================================
    // 🔒 RUTAS PRIVADAS (requieren autenticación)
    // ========================================
    "me_privado": {
      "header": {
        "method": "GET",
        "path": "/api/me/header",
        "auth": true,
        "version": "v1.0",
        "descripcion": "Datos mínimos para el header/navbar (rápido)",
        "cache": "5 minutos",
        "respuesta": {
          "nickname": "tech_lover",
          "avatar": "https://cloudflare-r2/avatars/lovers.webp",
          "is_authenticated": true
        }
      },
      "perfil": {
        "method": "GET",
        "path": "/api/me",
        "auth": true,
        "descripcion": "Obtener mi perfil completo (datos privados)",
        "version": "v1.0"
      },
      
      "actualizar": {
        "method": "PUT",
        "path": "/api/me",
        "auth": true,
        "descripcion": "Actualizar mi perfil",
        "version": "v2.0",  // MVP: solo lectura, v2: edición
        "body": {
          "nickname": "tech_lover_actualizado",
          "username": "tecnologico2025",
          "email": "nuevo@ejemplo.com"
        }
      },
      
      "cambiar_password": {
        "method": "PUT",
        "path": "/api/me/password",
        "auth": true,
        "descripcion": "Cambiar mi contraseña",
        "version": "v2.0",
        "body": {
          "password_actual": "MiPassword123!",
          "password_nueva": "NuevaPassword456!"
        }
      },
      
      "eliminar": {
        "method": "PUT",
        "path": "/api/me/delete",
        "auth": true,
        "descripcion": "Desactivar mi cuenta (soft delete)",
        "version": "v2.0",
        "body": {
          "password_confirm": "MiPassword123!"  // confirmación para evitar eliminación accidental
        }
      },
      
      "reactivar": {
        "method": "PUT",
        "path": "/api/me/reactivar",
        "auth": true,
        "descripcion": "Reactivar mi cuenta",
        "version": "v3.0",
        "nota": "MVP: innecesario, pero útil para futuros casos donde usuarios se arrepientan"
      },
      
      "logout": {
        "method": "POST",
        "path": "/api/me/logout",
        "auth": true,
        "descripcion": "Cerrar sesión (invalidar token)",
        "version": "v2.0",
        "nota": "Ideal: guardar token en blacklist en Redis/BD"
      },
      
      "avatar": {
        "subir": {
          "method": "POST",
          "path": "/api/me/avatar",
          "auth": true,
          "descripcion": "Subir mi avatar",
          "version": "v1.0",
          "body": {
            "form_data": {
              "imagen": "[Binary File]",
              "nombre": "Mi avatar"  // opcional: texto alternativo
            }
          }
        },
        "eliminar": {
          "method": "DELETE",
          "path": "/api/me/avatar",
          "auth": true,
          "descripcion": "Eliminar mi avatar",
          "version": "v2.0"
        }
      },
      
      "portada": {
        "subir": {
          "method": "POST",
          "path": "/api/me/portada",
          "auth": true,
          "descripcion": "Subir mi portada",
          "version": "v1.0",
          "body": {
            "form_data": {
              "imagen": "[Binary File]",
              "nombre": "Mi portada"
            }
          }
        },
        "eliminar": {
          "method": "DELETE",
          "path": "/api/me/portada",
          "auth": true,
          "descripcion": "Eliminar mi portada",
          "version": "v2.0"
        }
      },
      
      "imagenes": {
        "method": "GET",
        "path": "/api/me/imagenes",
        "auth": true,
        "descripcion": "Obtener todas mis imágenes",
        "version": "v1.0",
        "respuesta": {
          "avatar": {
            "url": "https://cloudflare-r2/avatars/lovers.webp",
            "nombre": "Mi avatar"
          },
          "portada": {
            "url": "https://cloudflare-r2/portadas/lovers_portada.webp",
            "nombre": "Mi portada"
          },
          "total": 2
        }
      }
    }
  }
}