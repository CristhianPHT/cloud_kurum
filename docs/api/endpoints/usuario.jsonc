{     // con body (cómo ingresar datos)
  "endpoints": {
    "usuarios": {
      "registrar": {
        "method": "POST",
        "path": "/users/register",
        "descripcion": "Registrar nuevo usuario",
        "autenticacion": false,
        "body": {
          "nickname": "tech_lover",  // opcional: si no se envía, se genera automático
          "username": "tecnologico2024",
          "password": "MiPassword123!",  // frontend: en texto plano, backend hashea
          "email": "usuario@ejemplo.com"
        },
        "respuesta": {
          "id": 1,
          "nickname": "tech_lover",
          "username": "tecnologico2024",
          "email": "usuario@ejemplo.com",
          "is_active": true,
          "created_at": "2024-01-15T10:30:00Z"
        }
      },
      
      "login": {
        "method": "POST",
        "path": "/api/users/login",
        "descripcion": "Iniciar sesión (retorna JWT)",
        "autenticacion": false,
        "body": {
          "username": "usuario@ejemplo.com",
          "password": "MiPassword123!"
        },
        "respuesta": {
          "token": "eyJhbGciOiJIUzI1NiIs...",
          "usuario": {
            "nickname": "tech_lover",
            "foto_perfil": "https://image/usuario01/cloudflare/xx1"
          }
        }
      },
      "perfil_publico": {
        "method": "GET",
        "path": "/api/users/:nickname",
        "descripcion": "Obtener perfil público del usuario",
          "autenticacion": false
      },
      "perfil_privado": {
        "method": "GET",
        "path": "/me",
        "descripcion": "Obtener todo el perfil privado del usuario",
        "autenticacion": true,
        "headers": { "Authorization": "Bearer {token}" },
        "respuesta": {
          "nickname": "Kurumi",
          "username": "kurumi",
          "url_image": "https://..."
          // toda la info del usuario
        },
        "errores": {
          "401": "No autenticado.",
          "404": "Cuenta no encontrada.",
          "500": "Error interno del servidor."
        }
      },
      "header": {
      "method": "GET",
      "path": "/me/header",
        "descripcion": "Obtiene la información necesaria para mostrar el encabezado (header) de la cuenta autenticada.",
        "autenticacion": true,
        "headers": { "Authorization": "Bearer {token}" },
        "respuesta": {
          "nickname": "Kurumi",
          "url_image": "https://..."
        },
        "errores": {
          "401": "No autenticado.",
          "404": "Cuenta no encontrada.",
          "500": "Error interno del servidor."
        }
      },
      "password": {
        "method": "PUT",
        "path": "/me/password",
        "descripcion": "Cambia la contraseña de la cuenta autenticada.",
        "autenticacion": true,
        "request": {
          "old_password": "MiContraseñaActual123",
          "new_password": "MiNuevaContraseña456"
        },
        "respuesta": {
          "message": "Contraseña actualizada correctamente."
        },
        "errores": {
          // "400": "Datos inválidos.",
          // "401": "No autenticado.",
          // "403": "La contraseña actual es incorrecta.",
          // "500": "Error interno del servidor."
        }
      },
      "logout": {
        "method": "POST",
        "path": "/me/logout",
        "descripcion": "Cerrar sesión (invalidar token)",
        "autenticacion": true,
        "headers": { "Authorization": "Bearer {token}" },
        "respuesta": {
          "mensaje": "Sesión cerrada correctamente"
        }
      },
      "nickname": {
        "method": "PUT",
        "path": "/me/nickname",
        "descripcion": "Cambiar el apodo del usuario.",
        "autenticacion": true,
        "headers": { "Authorization": "Bearer {token}"},
        "body":{
          "nickname": "new_nickname"
        },
        "respuesta": "Apodo actualizado correctamente."
      },


// --------------------------------------------------------------------------------------------------------
      "perfil": {
        "method": "GET",
        "path": "/api/me/portada-avatar",
        "descripcion": "Obtener perfil del usuario autenticado",
        "autenticacion": true,
        "headers": {
          "Authorization": "Bearer {token}"
        },
          "respuesta": {
            "id": 1,
            "nickname": "tech_lover",
            "username": "tecnologico2024",
            "email": "usuario@ejemplo.com",
            "is_active": true,
            "created_at": "2024-01-15T10:30:00Z",
            "updated_at": "2024-01-15T10:30:00Z"
          }
        },
        "eliminar": {
          "method": "PUT",  // soft delete
          "path": "/api/usuarios/perfil/delete",
          "descripcion": "Eliminar cuenta (soft delete - desactivar)",
          "autenticacion": true,
          "headers": {
            "Authorization": "Bearer {token}"
          },
          "body": {
            "password": "MiPassword123!"  // confirmación
          },
          "respuesta": {
            "mensaje": "Usuario desactivado correctamente"
          }
        },
        
        "reactivar": {
          "method": "PUT",
          "path": "/api/usuarios/perfil/reactivar",
          "descripcion": "Reactivar cuenta desactivada",
          "autenticacion": true,
          "headers": {
            "Authorization": "Bearer {token}"
          },
          "respuesta": {
            "mensaje": "Usuario reactivado correctamente",
            "is_active": true
          }
        }
      },
      
      "imagenes_perfil": {
        "subir_avatar": {
          "method": "POST",
          "path": "/api/usuarios/perfil/avatar",
          "descripcion": "Subir avatar de perfil",
          "autenticacion": true,
          "headers": {
            "Authorization": "Bearer {token}"
          },
          "body": {
            "form_data": {
              "imagen": "[Binary File]",  // archivo de imagen
              "nombre": "Mi avatar"  // opcional: texto alternativo
              // tipo: backend asigna "avatar" automáticamente
            }
          },
          "respuesta": {
            "id": 1,
            "url_image": "https://cloudflare-r2/avatars/user1_avatar.webp",
            "tipo": "avatar",
            "nombre": "Mi avatar",
            "is_active": true,
            "mime_type": "image/webp",
            "tamano_bytes": 245760,
            "ancho": 500,
            "alto": 500
          }
        },
        
        "subir_portada": {
          "method": "POST",
          "path": "/api/usuarios/perfil/portada",
          "descripcion": "Subir imagen de portada de perfil",
          "autenticacion": true,
          "headers": {
            "Authorization": "Bearer {token}"
          },
          "body": {
            "form_data": {
              "imagen": "[Binary File]",
              "nombre": "Mi portada"
            }
          },
          "respuesta": {
            "id": 2,
            "url_image": "https://cloudflare-r2/portadas/user1_portada.webp",
            "tipo": "portada",
            "nombre": "Mi portada",
            "is_active": true
          }
        },
        
        "obtener_imagenes": {
          "method": "GET",
          "path": "/api/usuarios/perfil/imagenes",
          "descripcion": "Obtener todas las imágenes del perfil (avatar + portada)",
          "autenticacion": true,
          "headers": {
            "Authorization": "Bearer {token}"
          },
          "respuesta": {
            "avatar": {
              "id": 1,
              "url_image": "https://cloudflare-r2/avatars/user1_avatar.webp",
              "nombre": "Mi avatar",
              "is_active": true
            },
            "portada": {
              "id": 2,
              "url_image": "https://cloudflare-r2/portadas/user1_portada.webp",
              "nombre": "Mi portada",
              "is_active": true
            }
          }
        },
        
        "eliminar_avatar": {
          "method": "DELETE",
          "path": "/api/usuarios/perfil/avatar",
          "descripcion": "Eliminar avatar actual",
          "autenticacion": true,
          "headers": {
            "Authorization": "Bearer {token}"
          },
          "respuesta": {
            "mensaje": "Avatar eliminado correctamente"
          }
        },
        
        "eliminar_portada": {
          "method": "DELETE",
          "path": "/api/usuarios/perfil/portada",
          "descripcion": "Eliminar portada actual",
          "autenticacion": true,
          "headers": {
            "Authorization": "Bearer {token}"
          },
          "respuesta": {
            "mensaje": "Portada eliminada correctamente"
          }
        }
      }
    }
  }

